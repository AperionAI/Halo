PORT=3012

# Paste the restricted *test* secret here (sk_test_...). Never commit this file.
# Path on the server: /opt/halo-license/.env  (mode 0600)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Test-mode prices from prices.csv (2026-08-14). Swap for live price_ IDs later.
STRIPE_PRICE_CUT=price_1U4QRRBy8SW7BDty1zt4pmAX
STRIPE_PRICE_ROUTE=price_1U4QS0By8SW7BDtySt9O1FQj
STRIPE_PRICE_GOVERN=price_1U4QSOBy8SW7BDtymac0hDwM

# Stripe Payment Link URLs (buy.stripe.com/...). /halo/buy/cut is a branded
# landing; ?go=1 skips straight to Stripe.
STRIPE_PAYMENT_LINK_CUT=
STRIPE_PAYMENT_LINK_ROUTE=

# Optional. Thanks page works without this. Token + From must both be set.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_STREAM=outbound

HALO_BIN=/opt/halo-license/bin/halo
# 32-byte seed with an explicit hex: prefix (bare hex is ambiguous with base64).
HALO_LICENSE_SIGNING_KEY=file:/opt/halo-license/signing.seed
LICENSE_DAYS=35
ISSUED_DIR=/opt/halo-license/issued
